# ==============================================================
# InterviewVerse AI Pro — Environment Configuration
# Copy this file to .env and fill in your keys.
# The app works fully in demo mode with NO keys set.
# ==============================================================

# Required for live AI-conducted interviews (question generation, streaming chat, coding questions)
GROQ_API_KEY=

# Required for multi-agent answer evaluation, scoring, and report generation
MISTRAL_API_KEY=

# OPTIONAL — Gemini never powers a mandatory feature. Leave blank to disable.
GEMINI_API_KEY=

# Model overrides (optional)
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-large-latest
GEMINI_MODEL=gemini-1.5-flash

# Session security — change this in any real deployment
JWT_SECRET=change-this-to-a-long-random-string
